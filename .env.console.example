# Copy to .env.console and chmod 0600. Password mode is the safe default.
# Generate its hash with: pnpm console:hash-password
# Never commit a populated hash or API key. Set disabled only for a deliberate public deployment.
CONSOLE_AUTH_MODE=password
CONSOLE_ADMIN_PASSWORD_HASH=

# Docker publishes CONSOLE_HOST_PORT on host loopback only. The container keeps port 4173.
# console:dev overrides the API port to 3000.
CONSOLE_HOST=127.0.0.1
CONSOLE_PORT=4173
CONSOLE_HOST_PORT=44173
CONSOLE_ALLOWED_ORIGIN=https://mcp-dashboard.mangagaki.net
CONSOLE_SECURE_COOKIES=true
# Compose overrides these container paths explicitly; local console:dev uses ./data.
CONSOLE_DATA_DIR=/data
# CONSOLE_DB_PATH=/data/console.sqlite
CONSOLE_REGISTRY_PATH=config/mcp-registry.json

# Optional MCP configuration. Blank secret values are not passed to child processes.
BRAVE_SEARCH_API_KEY=
DCINSIDE_DATA_DIR=/data/dcinside
