{
  "name": "@mymcp/dcinside",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read-only MCP server for DCInside",
  "bin": {
    "mymcp-dcinside": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/index.ts",
