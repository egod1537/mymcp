{
  "name": "@mymcp/japanese-vocab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Personal Japanese vocabulary and flashcard MCP server",
  "engines": {
    "node": ">=22.5.0"
  },
  "bin": {
    "mymcp-japanese-vocab": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "deploy": "wrangler deploy",
    "dev": "tsx src/index.ts",
    "dev:worker": "wrangler dev",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "agents": "0.31.0",
    "dotenv": "^18.0.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.4",
    "jsdom": "^30.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "wrangler": "4.154.0"
  }
}
