# Required. Keep the real value in your local environment or secret manager.
GOOGLE_MAPS_API_KEY=REPLACE_WITH_PRIVATE_KEY

# Optional cost and reliability controls.
GOOGLE_MAPS_HTTP_TIMEOUT_MS=8000
GOOGLE_MAPS_MAX_RETRIES=2
GOOGLE_MAPS_CALLS_PER_MINUTE=30
GOOGLE_MAPS_MAX_CONCURRENT_CALLS=2
LOG_LEVEL=info
GOOGLE_MAPS_LIVE_TESTS=0
