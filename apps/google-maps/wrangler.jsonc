{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "mcp-route",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "mcp-route.mangagaki.net",
      "custom_domain": true,
    },
  ],
  "ratelimits": [
    {
      "name": "MCP_RATE_LIMITER",
      "namespace_id": "1537",
      "simple": {
        "limit": 60,
        "period": 60,
      },
    },
  ],
  "observability": {
    "enabled": true,
  },
}
