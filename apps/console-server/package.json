{
  "name": "@mymcp/console-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify backend for the local MCP Console",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "dev": "tsx watch src/main.ts",
    "hash-password": "tsx src/cli/hash-password.ts",
    "start": "node dist/main.js",
    "test": "pnpm --filter @mymcp/mcp-client... build && pnpm --filter @mymcp/example... build && pnpm --filter @mymcp/dcinside build && vitest run",
    "typecheck": "pnpm --filter @mymcp/mcp-client... build && tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/rate-limit": "11.2.1",
    "@fastify/static": "10.1.8",
    "@mymcp/console-contracts": "workspace:*",
    "@mymcp/mcp-client": "workspace:*",
    "ajv": "8.20.0",
    "argon2": "0.45.1",
    "dotenv": "18.0.9",
    "fastify": "5.12.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
